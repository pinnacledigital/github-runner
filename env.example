# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# GitHub org name this runner registers to (RUNNER_SCOPE=org).
# Also used to construct the runner name: amd64-${ORG_NAME}-1
ORG_NAME=your_org_name

# Personal Access Token used to fetch fresh runner registration tokens
# on every container start. Must be a classic PAT — fine-grained PATs
# do not support the admin:org scope required for org-level runners.
#
# Required scopes:
#   admin:org  — register/list/delete org-level runners
#   repo       — register repo-level runners (only needed if RUNNER_SCOPE=repo)
#
# Generate at: GitHub → Settings → Developer settings →
#              Personal access tokens → Tokens (classic)
GITHUB_PAT=your_pat_here

# For each additional org, add a distinct variable and reference it in
# the corresponding service block in docker-compose.yml, e.g.:
# SECOND_ORG_NAME=your_second_org_name
